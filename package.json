{
  "name": "lectern",
  "version": "0.1.0",
  "description": "Author professional reveal.js slide decks as typed TSX components, styled by the ENGIE Fluid design system.",
  "type": "module",
  "license": "MIT",
  "bin": {
    "lectern": "./dist/cli/index.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./jsx-runtime": {
      "types": "./dist/jsx-runtime.d.ts",
      "import": "./dist/jsx-runtime.js"
    },
    "./jsx-dev-runtime": {
      "types": "./dist/jsx-runtime.d.ts",
      "import": "./dist/jsx-runtime.js"
    },
    "./tsconfig.json": "./tsconfig.authoring.json",
    "./vite-env": {
      "types": "./vite-env.d.ts"
    },
    "./engie": {
      "types": "./dist/profiles/engie/index.d.ts",
      "import": "./dist/profiles/engie/index.js"
    }
  },
  "files": [
    "dist",
    "src",
    "tsconfig.authoring.json",
    "vite-env.d.ts"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "lectern": "node --import tsx ./src/cli/index.ts"
  },
  "dependencies": {
    "@engie-group/fluid-design-system": "^6.2.0",
    "@engie-group/fluid-design-tokens": "^6.2.0",
    "cytoscape": "^3.34.1",
    "infograph": "^1.0.0",
    "mermaid": "^11.16.0",
    "preact": "^10.24.0",
    "preact-render-to-string": "^6.5.0",
    "reveal.js": "^6.0.1",
    "vite": "^7.0.0",
    "vite-plugin-singlefile": "^2.0.0"
  },
  "peerDependencies": {
    "playwright": "^1.48.0"
  },
  "peerDependenciesMeta": {
    "playwright": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "playwright": "^1.48.0",
    "prettier": "^3.9.4",
    "tsup": "^8.3.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0"
  },
  "prettier": {
    "printWidth": 120,
    "tabWidth": 2,
    "singleQuote": true,
    "arrowParens": "avoid",
    "bracketSameLine": true,
    "semi": false,
    "endOfLine": "lf",
    "experimentalTernaries": true,
    "proseWrap": "never",
    "trailingComma": "es5",
    "overrides": [
      {
        "files": "**/*.ts",
        "options": {
          "parser": "typescript"
        }
      },
      {
        "files": [
          "**/*.ts",
          "**/*.tsx",
          "**/*.js",
          "**/*.jsx"
        ],
        "options": {
          "tabWidth": 4
        }
      }
    ]
  }
}

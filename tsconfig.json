{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "jsx": "react-jsx",
    "jsxImportSource": "preact",
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "types": ["node"],
    // Typecheck-only: this config covers the whole project for the editor and
    // `tsc --noEmit`. Emit settings live in tsconfig.build.json.
    "noEmit": true,
    // Inside this repo a deck imports the bare `lectern` specifier, which the
    // package's own exports map can't resolve to itself. Point it at source so
    // examples typecheck.
    "baseUrl": ".",
    "paths": {
      "lectern": ["./src/index.ts"],
      "lectern/jsx-runtime": ["./src/jsx-runtime.ts"],
      "lectern/engie": ["./src/profiles/engie/index.ts"]
    }
  },
  "include": ["**/*.ts", "**/*.tsx"],
  "exclude": ["node_modules", "dist"]
}

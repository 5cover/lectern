{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "jsx": "react-jsx",
    "jsxImportSource": "@5cover/lectern",
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "types": ["node"],
    // Typecheck-only: this config covers the whole project for the editor and
    // `tsc --noEmit`. Emit settings live in tsconfig.build.json.
    "noEmit": true,
    // Resolve the package's public names to source while working in this repo.
    "paths": {
      "@5cover/lectern": ["./src/index.ts"],
      "@5cover/lectern/jsx-runtime": ["./src/jsx-runtime.ts"],
      "@5cover/lectern/jsx-dev-runtime": ["./src/jsx-runtime.ts"],
      "@5cover/lectern/engie": ["./src/profiles/engie/index.ts"]
    }
  },
  "include": ["**/*.ts", "**/*.tsx"],
  "exclude": ["node_modules", "dist"]
}
